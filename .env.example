# Database
DB_USERNAME=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payment_db

# Payment Gateways
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
STRIPE_API_KEY=your_stripe_api_key

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ========================================
# Payment Service Environment Configuration
# ========================================

# Copy this file to .env and fill in your actual values
# Never commit .env file to git (already in .gitignore)

# ========================================
# Database Configuration
# ========================================
DB_USERNAME=root
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=3307
DB_NAME=payment_db

# ========================================
# Stripe Payment Gateway (Active)
# ========================================
# Get your keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Test card for Stripe: 4242 4242 4242 4242
# Any future expiry, any CVC

# ========================================
# Razorpay Payment Gateway (Optional)
# ========================================
# Get your keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_ENABLED=false

# ========================================
# Application Configuration
# ========================================
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ========================================
# Payment Gateway Selection
# ========================================
# Options: STRIPE, RAZORPAY
PAYMENT_GATEWAY_DEFAULT=STRIPE

# ========================================
# Redis Configuration (for Phase 3)
# ========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========================================
# Kafka Configuration (for Phase 4)
# ========================================
KAFKA_BROKERS=localhost:9092

